# ───── Stage 1: builder ─────
FROM nvidia/cuda:12.1.0-cudnn8-runtime-ubuntu22.04 AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    git build-essential libsndfile1 libportaudio2 \
    python3.11 python3.11-dev python3.11-distutils python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && ln -sf /usr/bin/python3.11 /usr/bin/python3

WORKDIR /build
COPY pyproject.toml setup.cfg setup.py README.md ./
COPY src/ ./src/
RUN pip install --no-cache-dir torch==2.4.1 torchaudio==2.4.1 torchvision==0.19.1 --index-url https://download.pytorch.org/whl/cu121
# Non-editable install so diart + diart_server land in dist-packages and
# stage 2's COPY brings them along (an editable install only places a .pth
# pointer to /build/src which doesn't exist in stage 2).
RUN pip install --no-cache-dir ".[server]"

# Pull models with HF_TOKEN injected as a BuildKit secret. The secret never
# lands in any image layer or metadata.
COPY docker/download_models.py docker/models.json ./docker/
RUN --mount=type=secret,id=hf_token,required=true \
    HF_TOKEN="$(cat /run/secrets/hf_token)" \
    python docker/download_models.py /app/models

# ───── Stage 2: runtime ─────
FROM nvidia/cuda:12.1.0-cudnn8-runtime-ubuntu22.04
# libportaudio2: diart.sources unconditionally imports `sounddevice` at module
# level (used by MicrophoneAudioSource even though server-side flow only uses
# MeetingAudioSource). Without it, uvicorn fails before reaching lifespan.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg libsndfile1 libportaudio2 \
    python3.11 python3.11-distutils \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && ln -sf /usr/bin/python3.11 /usr/bin/python3 \
    && useradd -m -u 1000 diart

# Note: GPU image uses Ubuntu 22.04 + python3.11 from apt; pip installs to
# /usr/local/lib/python3.11/dist-packages (NOT site-packages like python:3.11-slim).
COPY --from=builder /usr/local/lib/python3.11/dist-packages /usr/local/lib/python3.11/dist-packages
COPY --from=builder /usr/local/bin/uvicorn /usr/local/bin/uvicorn
COPY --from=builder /app/models /app/models
# Bake the manifest next to the model files so app.py's _resolve_manifest_path
# finds it without needing the source tree at /build.
COPY docker/models.json /app/models/models.json
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && chown -R diart:diart /app

USER diart
WORKDIR /app
ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    DIART_MODELS_DIR=/app/models \
    DIART_DEVICE=cuda \
    DIART_PORT=7007 \
    PYTHONUNBUFFERED=1

EXPOSE 7007
ENTRYPOINT ["/entrypoint.sh"]
CMD ["uvicorn", "diart_server.app:app", "--host", "0.0.0.0", "--port", "7007", "--workers", "1"]
